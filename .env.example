OPENAI_API_KEY=
RENTCAST_API_KEY=
OPENAI_MODEL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app
CLERK_WEBHOOK_SECRET=

# Neon (from Vercel Marketplace)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob (optional locally; OIDC on Vercel)
BLOB_READ_WRITE_TOKEN=

# Dev only: allow app access before Clerk Billing plans exist
ALLOW_UNPAID_ACCESS=true

# Set true only after Clerk Billing is enabled (otherwise PricingTable crashes)
NEXT_PUBLIC_CLERK_BILLING_ENABLED=false

# Resend (transactional email — org invitations)
# 1. Create account at https://resend.com
# 2. Add domain: invites.oldvinepropertiesllc.com
# 3. Add CNAME + TXT records in Squarespace DNS (see below)
# 4. Paste API key here
RESEND_API_KEY=
RESEND_FROM=invites@invites.oldvinepropertiesllc.com
RESEND_REPLY_TO=info@oldvinepropertiesllc.com

# Seed script
OLD_VINE_ADMIN_EMAIL=
